#!/bin/bash

usage() {
    echo "Usage: pod-image <pod-name> [kubectl options...]"
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    "")
        usage >&2
        exit 1
        ;;
esac

pod_name=$1
shift

exec kubectl get pod "$pod_name" "$@" \
    -o jsonpath='{range .spec.containers[*]}{.name}{": "}{.image}{"\n"}{end}'
